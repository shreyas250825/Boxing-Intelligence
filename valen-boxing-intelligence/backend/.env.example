# Database — SQLite for local dev; replace with postgresql:// for production
DATABASE_URL=sqlite:///./data/valen_boxing.db

# Security — change in production
SECRET_KEY=change-me-in-production

# CORS — comma-separated allowed origins (no trailing slashes)
# Production example:
CORS_ORIGINS=http://localhost:5173,https://boxing-intelligence.vercel.app

# File storage (relative to backend/ directory)
STORAGE_DIR=./data/videos
REPORTS_DIR=./data/reports

# Upload limit (bytes) — default 2 GB
MAX_UPLOAD_BYTES=2147483648

# Analysis config
FRAME_INTERVAL_SECONDS=0.5
MAX_FRAMES=500

# -----------------------------------------------------------------------
# AI CORNER — Local Ollama configuration (required for AI features)
# -----------------------------------------------------------------------
#
# Architecture: Frontend + Backend + Ollama all run on your local machine.
# Do NOT expose Ollama's port (11434) to the internet.
#
# Setup steps:
#   1. Install Ollama: https://ollama.com/download
#   2. Pull a model:   ollama pull llama3:latest
#   3. Start Ollama:   ollama serve
#   4. Start backend:  uvicorn app.main:app --reload
#
# Verify: GET http://localhost:8000/health  -> ai.available should be true
#
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------
# Email delivery — set to true and implement sending to enable production
# password recovery. When false (default), the reset token is returned
# directly in the API response for development/testing.
# -----------------------------------------------------------------------
EMAIL_DELIVERY_CONFIGURED=false
