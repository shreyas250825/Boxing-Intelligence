# Database — SQLite for local dev; replace with postgresql:// for production
DATABASE_URL=sqlite:///./data/valen_boxing.db

# Security — change in production
SECRET_KEY=change-me-in-production

# CORS — comma-separated allowed origins (include the Vercel URL in production)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# File storage (relative to backend/ directory)
STORAGE_DIR=./data/videos
REPORTS_DIR=./data/reports

# Upload limit (bytes) — default 2 GB
MAX_UPLOAD_BYTES=2147483648

# Analysis config
FRAME_INTERVAL_SECONDS=0.5
MAX_FRAMES=500

# -----------------------------------------------------------------------
# AI CORNER — required to enable the AI companion features
# -----------------------------------------------------------------------

# Your OpenAI API key. Required for all AI Corner features.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Alternative provider base URL (optional).
# Use this to point to any OpenAI-compatible API (e.g. Azure, Groq, Ollama).
OPENAI_BASE_URL=

# Model to use. Default: gpt-4o-mini (fast and cost-efficient).
# Other options: gpt-4o, gpt-4-turbo
AI_MODEL=gpt-4o-mini
