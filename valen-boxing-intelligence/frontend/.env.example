# Local Vite: leave this pointing at the API, or omit it and use the /api proxy.
VITE_API_BASE_URL=http://localhost:8000

# Vercel production:
# Set this at build time to the Render API origin (no trailing slash).
# Video streams directly from Render with CORS so Range requests are not
# proxied through Vercel. Also set Render CORS_ORIGINS to your Vercel URL.
# VITE_API_BASE_URL=https://boxing-intelligence.onrender.com
